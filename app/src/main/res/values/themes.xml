<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ══ App Theme ══ -->
    <style name="Theme.SmsWebhookForwarder" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/iosBlue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/iosBlue</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurface">@color/iosCard</item>
        <item name="colorSurfaceVariant">@color/iosInputFill</item>
        <item name="android:windowBackground">@color/iosBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/iosBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!-- ══ Typography ══ -->

    <style name="TextAppearance.iOS" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.iOS.LargeTitle">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/iosPrimaryText</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.iOS.SectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/iosSecondaryText</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="TextAppearance.iOS.Headline">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/iosPrimaryText</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.iOS.Body">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/iosPrimaryText</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.iOS.Subheadline">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/iosPrimaryText</item>
    </style>

    <style name="TextAppearance.iOS.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/iosSecondaryText</item>
    </style>

    <!-- ══ Card ══ -->

    <style name="Widget.iOS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardMaxElevation">2dp</item>
        <item name="cardBackgroundColor">@color/iosCard</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ══ Buttons ══ -->

    <!-- Filled pill — iOS blue -->
    <style name="Widget.iOS.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">50dp</item>
        <item name="backgroundTint">@color/iosBlue</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Outlined pill — iOS blue stroke -->
    <style name="Widget.iOS.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">50dp</item>
        <item name="strokeColor">@color/iosBlue</item>
        <item name="android:textColor">@color/iosBlue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Inline text button — iOS blue, used for expand/collapse chevrons -->
    <style name="Widget.iOS.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/iosBlue</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- ══ Text Input — iOS filled rounded rectangle ══ -->

    <style name="Widget.iOS.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/iosInputFill</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/iosSecondaryText</item>
        <item name="android:textColorHint">@color/iosSecondaryText</item>
    </style>

</resources>
